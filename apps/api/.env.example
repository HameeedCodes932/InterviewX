# Copy to apps/api/.env and fill in local values.
# Do not commit real secrets.

# Application
APP_NAME=InterviewX API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL — SQLAlchemy URL (psycopg3 driver)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://interviewx:CHANGE_ME@127.0.0.1:5432/interviewx

# JWT authentication
# Required: at least 32 characters. Placeholder values are rejected outside APP_ENV=test.
# Generate a strong secret (PowerShell / bash / Python):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe_48
JWT_ALGORITHM=HS256
# Must be a positive integer (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
