# InterviewX — local development
# Copy to .env and adjust as needed.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://interviewx:interviewx@localhost:5432/interviewx

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Password reset email
# TODO: Configure SMTP to send real reset emails. Until then the API returns
# the reset token in the response (dev-only) and logs it.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@interviewx.local
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Future OSS AI (stubs — not required for auth/dashboard)
# OLLAMA_BASE_URL=http://localhost:11434
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
