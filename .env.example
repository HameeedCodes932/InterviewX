# InterviewX — local development
# Copy to .env and adjust as needed.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://interviewx:interviewx@localhost:5432/interviewx

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Password reset email
# TODO: Configure SMTP to send real reset emails. Until then the API returns
# the reset token in the response (dev-only) and logs it.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@interviewx.local
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Self-hosted LiveKit (docker compose `livekit` service — --dev defaults)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=interviewx-interviewer

# Shared secret for agent → FastAPI
AGENT_API_KEY=dev-agent-api-key-change-me
BACKEND_URL=http://localhost:8000

# Ollama (LLM) — pull e.g. `ollama pull llama3.2:3b` (licence-verify model weights)
# On low-RAM machines `llama3.2:1b` also works.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Whisper / faster-whisper (STT)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Piper (TTS) — distinct male/female voices; licence-verify each ONNX
PIPER_BINARY=piper
PIPER_VOICES_DIR=
PIPER_VOICE_MALE=en_US-lessac-medium
PIPER_VOICE_FEMALE=en_US-amy-medium
# PIPER_SPEAKER_MALE=
# PIPER_SPEAKER_FEMALE=
